# Provider: openai (default) or deepseek
# LLM_PROVIDER=openai

# OpenAI API Key (required when LLM_PROVIDER=openai, the default)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key (required when LLM_PROVIDER=deepseek)
# Get your key at https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Used when an agent still names an OpenAI model (gpt-*, o1-*, ft:*).
# Agent models that already start with "deepseek" are left unchanged.
# DEEPSEEK_MODEL=deepseek-flash
# DeepSeek thinking mode ignores temperature. Leave this disabled unless you
# want chain-of-thought answers.
# DEEPSEEK_THINKING=disabled
